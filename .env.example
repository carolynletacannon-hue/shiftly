NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Use a dedicated free Gmail account, not your personal account.
# Both are required; otherwise manual invitation links remain available.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Server-only, optional for best-effort time-off email delivery through Gmail.
# Use the Supabase service_role key for this same project. Never NEXT_PUBLIC_.
# Requests, decisions and private in-app notifications persist without it.
SUPABASE_SERVICE_ROLE_KEY=
