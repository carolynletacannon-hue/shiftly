NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Use a dedicated free Gmail account, not your personal account.
# Both are required; otherwise manual invitation links remain available.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Server-only: required for calendar feeds; optional for Gmail notifications.
# Never use NEXT_PUBLIC_ for these values.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Enable only after the Phase 6 migration and request-log privacy checks.
# Calendar subscriptions also require NEXT_PUBLIC_SITE_URL to use HTTPS.
CALENDAR_FEEDS_ENABLED=false

# Phase 7: leave disabled until migration, preview tests, and manual review.
# Disabling this never disables invitation or password emails.
PHASE7_EMAIL_ENABLED=false
